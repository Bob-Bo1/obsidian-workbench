{
  "name": "obsidian-workbench",
  "version": "0.1.0-beta.1",
  "description": "在 DeepSeek Harness 内浏览、编辑并保存 Obsidian Markdown 仓库。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bob-Bo1/obsidian-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/Bob-Bo1/obsidian-workbench/issues"
  },
  "homepage": "https://github.com/Bob-Bo1/obsidian-workbench#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "obsidian",
    "markdown",
    "vault"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "package.json"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "node --check lib/index.js && node --check lib/client-source.js && npm run build:client && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "esbuild": "^0.25.9"
  }
}
